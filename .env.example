# Copy this file to .env and fill in the real values.
# .env is gitignored — never commit it.

# Bot token: Discord Developer Portal > your app > Bot > Reset Token
# Also enable there: SERVER MEMBERS INTENT + MESSAGE CONTENT INTENT
TOKEN=

# Application ID: Developer Portal > your app > General Information
CLIENT_ID=

# Guild used by deploy-commands.js when registering the /setup slash command
GUILD_ID=
